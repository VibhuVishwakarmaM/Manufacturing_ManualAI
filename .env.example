# ==============================================================================
# MANUFACTURING MANUAL AI ASSISTANT - CONFIGURATION ENVIRONMENT
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-manufacturing-manual-ai-prod-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=manufacturing_manuals
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Set to True only when PostgreSQL is unreachable in local dev testing environments
USE_SQLITE_FALLBACK=True

# LLM Configuration (Options: mock, openai, anthropic, ollama)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1

# Embedding Configuration (Options: mock, openai, local)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_DIMENSION=1536

# Vector Store Configuration (Options: in_db, json_store, pgvector)
VECTOR_STORE_PROVIDER=in_db
VECTOR_COLLECTION=manual_chunks
VECTOR_STORE_URL=

# Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.35 # (0.35 for mock/local, 0.65 for dense OpenAI embeddings)

# Document & Upload Policy
MAX_UPLOAD_SIZE_MB=25
ALLOWED_PDF_TYPES=application/pdf

# Prompt & Generation
RAG_PROMPT_VERSION=v1
